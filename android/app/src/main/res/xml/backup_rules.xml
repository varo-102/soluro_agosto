<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Incluir base de datos SQLite y archivos de transacción WAL -->
    <include domain="database" path="soluro_database.db" />
    <include domain="database" path="soluro_database.db-wal" />
    <include domain="database" path="soluro_database.db-shm" />

    <!-- Incluir archivos persistentes de la app (imágenes QR y fotos de cotizaciones) -->
    <include domain="file" path="app_flutter/qr_images" />
    <include domain="file" path="app_flutter/cotizaciones_fotos" />

    <!-- Incluir preferencias del usuario -->
    <include domain="sharedpref" path="." />

    <!-- Excluir almacenamiento sensible cifrado para evitar corrupción de Keystore tras reinstalación -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
